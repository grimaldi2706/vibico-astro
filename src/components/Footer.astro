---
import config from "../config/index.js";
const year = new Date().getFullYear();

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t =
  config.languages[lang as keyof typeof config.languages] ||
  config.languages.es;
const common = config.common;
---

<footer class="bg-slate-950 border-t border-slate-800 text-slate-400 py-8 mt-8 print:hidden">
  <div class="container">
    <div class="flex flex-col md:flex-row justify-between items-center gap-8">
      <div class="text-center md:text-left">
        <h3 class="text-xl font-bold text-white font-serif mb-2">{t.site.title}</h3>
        <p class="text-sm text-slate-500">
          Desarollado por <span class="text-teal-500">Grimaldi Cuaical Gomez</span>
        </p>
      </div>

      <div class="flex gap-6">
        {
          Object.entries(common.social_footer).map(([platform, url]) => (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-900 border border-slate-800 hover:border-teal-500/50 hover:text-teal-400 transition-all"
              aria-label={platform}
            >
              <!-- Simple circle placeholder for icons, can be replaced with actual icons -->
              <span class="text-xs font-bold uppercase">{platform.slice(0,2)}</span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="border-t border-slate-800/50 mt-12 pt-8 text-center text-xs text-slate-600">
      &copy; {year} {t.site.title}. {
        lang === "es"
          ? "Todos los derechos reservados."
          : "All rights reserved."
      }
    </div>
  </div>
</footer>
