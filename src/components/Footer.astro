---
import config from "../config/index.js";
const year = new Date().getFullYear();

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t =
  config.languages[lang as keyof typeof config.languages] ||
  config.languages.es;
const common = config.common;

const socialIcons: Record<string, string> = {
  facebook:
    "M12 2.04c-5.5 0-10 4.49-10 10.02 0 5 3.66 9.15 8.44 9.9v-7H7.9v-2.9h2.54V9.85c0-2.51 1.49-3.89 3.78-3.89 1.09 0 2.23.19 2.23.19v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.9h-2.33v7c4.78-.75 8.44-4.9 8.44-9.9 0-5.53-4.5-10.02-10-10.02z",
  instagram:
    "M12 2.98c2.72 0 3.04.01 4.12.06 1.95.08 3.21.95 3.85 1.93.64.98.86 2.08.86 4.07v4.22c0 2-.22 3.1-.86 4.08-.64.98-1.9 1.85-3.85 1.93-1.08.05-1.4.06-4.12.06s-3.04-.01-4.12-.06c-1.95-.08-3.21-.95-3.85-1.93-.64-.98-.86-2.08-.86-4.08V9.04c0-2 .22-3.1.86-4.07.64-.98 1.9-1.85 3.85-1.93 1.08-.05 1.4-.06 4.12-.06m0-2.98C9.22 0 8.87.01 7.74.06 4.9.18 2.93 1.2 1.72 3.06.5 4.94.2 6.83.2 10.04v4.22c0 3.2.3 5.1 1.52 6.98 1.21 1.85 3.18 2.87 6.02 3 1.13.04 1.48.06 4.26.06s3.13-.02 4.26-.06c2.84-.13 4.81-1.15 6.02-3 1.22-1.88 1.52-3.78 1.52-6.98V10.04c0-3.21-.3-5.1-1.52-6.98C19.07 1.2 17.1.18 14.26.06 13.13.01 12.78 0 12 0m0 5.87a5.9 5.9 0 000 11.8 5.9 5.9 0 000-11.8m0 9.74a3.84 3.84 0 110-7.68 3.84 3.84 0 010 7.68m5.55-9.24a1.38 1.38 0 11-2.76 0 1.38 1.38 0 012.76 0",
  twitter:
    "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
  paypal:
    "M7.076 21.337H2.47a.641.641 0 01-.633-.74L4.944.901C5.026.382 5.474 0 5.998 0h7.46c2.57 0 4.578.543 5.69 1.81 1.01 1.15 1.304 2.42 1.012 4.287-.023.143-.047.288-.077.437-.983 5.05-4.349 6.797-8.647 6.797h-2.19c-.524 0-.968.382-1.05.9l-1.12 7.106z",
};
---

<footer class="mt-12 print:hidden border-t border-slate-800/50">
  <div class="bg-slate-900/40 backdrop-blur-sm">
    <div class="container py-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
        <div class="text-center md:text-left">
          <span
            class="text-lg font-bold italic text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400 p-2"
          >
            {t.site.logoText}
          </span>
          <p class="text-xs text-slate-500">{t.site.description}</p>
        </div>

        <div class="flex justify-center gap-3">
          {
            Object.entries(common.social_footer).map(([platform, url]) => (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-800/60 border border-slate-700/50 hover:border-cyan-500/50 text-slate-400 hover:text-cyan-400 hover:bg-slate-700/60 transition-all"
                aria-label={platform}
              >
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d={socialIcons[platform] || ""} />
                </svg>
              </a>
            ))
          }
        </div>

        <div class="text-center md:text-right text-xs text-slate-500 space-y-1">
          <p>
            <span class="text-cyan-400">✉</span>
            {" "}{common.contact.email}
          </p>
          <p>
            <span class="text-cyan-400">✆</span>
            {" "}{common.contact.phone}
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-slate-800/30 py-5">
    <div class="container text-center text-xs text-slate-600 space-y-1">
      <p class="text-sm">
        {lang === "es" ? "Desarrollado por" : "Developed by"}
        {" "}<span class="text-slate-500 hover:text-cyan-400 transition-colors">Grimaldi Cuaical Gomez</span>
      </p>
      <p>
        &copy; {year} {t.site.title}. {
          lang === "es"
            ? "Todos los derechos reservados."
            : "All rights reserved."
        }
      </p>
    </div>
  </div>
</footer>
