---
interface Props {
  data: Record<string, any>;
}

const { data } = Astro.props;
---

{
  Object.entries(data).map(([key, item]) => (
    <div class="max-w-6xl mx-auto mt-10">
      <div class="card overflow-hidden p-0">
        <div class="grid grid-cols-1 md:grid-cols-2">
          <div class="relative aspect-[4/3] md:aspect-auto md:min-h-[400px]">
            <iframe
              src={item.link_mapa}
              class="absolute inset-0 w-full h-full"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            />
          </div>

          <div class="p-6 md:p-8 flex flex-col justify-center">
            <h3 class="text-xl font-bold text-white mb-4">{item.title}</h3>
            {item.parrafos &&
              Object.entries(item.parrafos).map(([key, parrafos]: any) => (
                <p class="text-sm text-slate-400 leading-relaxed mb-3">
                  {parrafos}
                </p>
              ))}
            {item.items &&
              Object.entries(item.items).length > 0 && (
              <div class="flex flex-wrap gap-2 mt-2">
                {Object.entries(item.items).map(([key, items]: any) => (
                  <span class="px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-800 text-slate-300 border border-slate-700">
                    {items}
                  </span>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  ))
}
