---
import config from "../config/index.js";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t =
  config.languages[lang as keyof typeof config.languages] ||
  config.languages.es;

interface NavigationItem {
  label: string;
  href: string;
  subitems?: { label: string; href: string }[];
}

const navigation = t.navigation as NavigationItem[];

const getPath = (path: string) => {
  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  return path === "/" ? base || "/" : `${base}${path}`;
};

const targetLang = lang === "es" ? "en" : "es";
const targetLabel = lang === "es" ? "EN" : "ES";
const targetHref = getPath(lang === "es" ? "/en" : "/");
const logoSrc = getPath(config.common.logo);
---

<header
  class="bg-slate-950/80 backdrop-blur-lg text-gray-200 border-b border-slate-800/50 sticky top-0 z-50 print:hidden shadow-lg shadow-black/20"
>
  <div class="container flex justify-between items-center py-3">
    <a
      href={getPath(lang === "es" ? "/" : `/${lang}`)}
      class="flex items-center gap-3 text-2xl font-bold tracking-tight hover:opacity-90 transition-opacity group"
    >
      <img
        src={logoSrc}
        alt="VIBICO Logo"
        class="h-12 w-auto rounded-full shadow-md group-hover:shadow-teal-500/20 transition-shadow duration-300 border border-slate-700"
      />
      <span class="font-serif text-teal-100">{t.site.logoText}</span>
    </a>

    <div class="hidden md:flex items-center gap-8">
      <nav class="flex gap-6">
        {
          navigation.map((item) => (
            <div class="relative group">
              <a
                href={getPath(item.href)}
                class="text-sm font-semibold text-slate-300 hover:text-teal-400 transition-colors flex items-center gap-1 py-2"
              >
                {item.label}
                {item.subitems && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-3 w-3 transition-transform group-hover:rotate-180"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                )}
              </a>
              {item.subitems && (
                <div class="absolute left-0 mt-2 w-48 bg-slate-900/95 backdrop-blur-xl rounded-lg shadow-xl shadow-black/50 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform origin-top-left z-50 border border-slate-700/50">
                  <div class="py-2">
                    {item.subitems.map((subitem) => (
                      <a
                        href={getPath(subitem.href)}
                        class="block px-4 py-2 text-sm text-slate-400 hover:bg-slate-800 hover:text-teal-400 transition-colors"
                      >
                        {subitem.label}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          ))
        }
      </nav>

      <a
        href={targetHref}
        class="px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider border border-teal-500/30 text-teal-300 hover:bg-teal-500/10 hover:text-teal-200 hover:border-teal-400 transition-all"
        aria-label={`Switch to ${targetLabel}`}
      >
        {targetLabel}
      </a>
    </div>

    <button
      id="mobile-menu-btn"
      class="md:hidden text-slate-400 hover:text-teal-400 focus:outline-none"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-slate-950 border-t border-slate-800 absolute w-full left-0 shadow-2xl"
  >
    <nav class="flex flex-col p-4 gap-4">
      {
        navigation.map((item) => (
          <div>
            <a
              href={getPath(item.href)}
              class="text-slate-300 hover:text-teal-400 font-medium block py-2 border-b border-slate-800/50"
            >
              {item.label}
            </a>
            {item.subitems && (
              <div class="pl-4 mt-2 space-y-2 border-l-2 border-slate-800">
                {item.subitems.map((subitem) => (
                  <a
                    href={getPath(subitem.href)}
                    class="text-slate-500 hover:text-teal-400 text-sm block py-1"
                  >
                    {subitem.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))
      }
      <a
        href={targetHref}
        class="text-teal-400 hover:text-teal-300 font-bold block pt-4 border-t border-slate-800 mt-2 text-center"
      >
        Cambiar a {targetLabel}
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });
</script>
