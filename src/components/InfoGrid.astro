---
interface Props {
  data: Record<string, any>;
  gridCols?: string;
  cardType?: "info" | "emergency" | "support";
}

const {
  data,
  gridCols = "grid-cols-1 md:grid-cols-2 lg:grid-cols-3",
  cardType = "info",
} = Astro.props;
---

<div class={`grid ${gridCols} gap-6`}>
  {
    Object.entries(data).map(([key, item]) => {
      if (cardType === "info") {
        return (
          <div class="card overflow-hidden p-0 flex flex-col group hover:border-cyan-600/30">
            <div class="px-2 pt-4 pb-3 bg-slate-900/60">
              <h3 class="text-base font-bold text-white leading-snug text-center">
                {item.title}
              </h3>
            </div>
            <div class="w-full bg-slate-900 flex items-center justify-center py-2 px-4 min-h-[100px]">
              <img
                src={item.image}
                alt={item.title}
                class="w-auto h-auto max-w-full max-h-32 object-contain"
              />
            </div>
            <div class="p-3 flex flex-col flex-1">
              <details class="group/details mb-4 flex-1 flex flex-col">
                <p class="text-sm text-slate-400 leading-relaxed line-clamp-3 group-open/details:line-clamp-none transition-all duration-300">
                  {item.description}
                </p>
                <summary class="list-none cursor-pointer text-xs font-semibold text-cyan-400 hover:text-cyan-300 mt-2 self-center px-3 py-1 rounded-full bg-slate-800/50 hover:bg-slate-800 transition-colors">
                  <span class="group-open/details:hidden">Ver más</span>
                  <span class="hidden group-open/details:inline">
                    Ver menos
                  </span>
                </summary>
              </details>
              {item.links && Object.entries(item.links).length > 0 && (
                <div class="flex flex-col gap-2 mt-auto">
                  {Object.entries(item.links).map(([keys, link]: any) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-center gap-1.5 w-full px-4 py-2.5 rounded-lg text-xs font-semibold transition-all no-underline bg-slate-800 text-slate-300 hover:bg-cyan-700/40 hover:text-cyan-300 border border-slate-700 hover:border-cyan-600/50"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>
        );
      }

      if (cardType === "emergency") {
        return (
          <div class="card p-5 flex flex-col items-center text-center transition-all">
            <div class="w-20 h-20 rounded-full bg-slate-800/90 border-2 border-cyan-700/30 flex items-center justify-center mb-4 overflow-hidden flex-shrink-0">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover"
              />
            </div>
            <h3 class="text-sm font-semibold text-white mb-4 leading-tight">
              {item.title}
            </h3>
            {item.tel &&
              Object.entries(item.tel).map(([keys, link]: any) => (
                <a
                  href={link.url}
                  class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold transition-all no-underline bg-cyan-600/20 text-cyan-400 hover:bg-cyan-600/30 hover:text-cyan-300 border border-cyan-700/30 w-full justify-center"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                    />
                  </svg>
                  {link.label}
                </a>
              ))}
          </div>
        );
      }

      if (cardType === "support") {
        return (
          <div class="card p-5 flex flex-col items-center text-center transition-all">
            <div class="w-24 h-24 rounded-full bg-slate-800/90 border-2 border-cyan-700/20 flex items-center justify-center mb-4 overflow-hidden flex-shrink-0">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover"
              />
            </div>
            <h3 class="text-base font-bold text-white mb-2">{item.title}</h3>
            <p class="text-sm text-slate-400 mb-5 leading-relaxed">
              {item.description}
            </p>
            <div class="mt-auto flex flex-wrap justify-center gap-2 w-full">
              {item.links &&
                Object.entries(item.links).map(([keys, link]: any) => (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 min-w-[120px] inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-lg text-xs font-semibold transition-all no-underline bg-slate-800 text-slate-300 hover:bg-cyan-700/40 hover:text-cyan-300 border border-slate-700 hover:border-cyan-600/50"
                  >
                    {link.label}
                  </a>
                ))}
            </div>
          </div>
        );
      }
    })
  }
</div>
