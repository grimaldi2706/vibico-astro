---
import config from "../../config/index.js";

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith("/en") ? "en" : "es";
const configSite = config.languages[lang].site.home;
---

<section class="relative overflow-hidden py-8 md:py-12">
  <div class="absolute inset-0" aria-hidden="true">
    <div
      class="absolute top-1/3 -left-32 w-96 h-96 rounded-full bg-cyan-600/8 blur-3xl"
    >
    </div>
    <div
      class="absolute bottom-1/3 -right-32 w-96 h-96 rounded-full bg-blue-600/8 blur-3xl"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.03]"
      style="background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 60px 60px;"
    >
    </div>
  </div>

  <div class="container relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <div>
        <h1
          class="text-4xl sm:text-5xl lg:text-7xl font-bold tracking-tight leading-[1.1]"
        >
          {configSite.title1}
          <span
            class="block mt-2 text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-purple-400 italic"
          >
            {configSite.title2}
          </span>
        </h1>

        <p class="mt-3 text-lg text-slate-400 leading-relaxed max-w-xl">
          {configSite.description1}
        </p>

        <p
          class="mt-2 text-sm text-slate-500 italic border-l-4 border-cyan-500/50 pl-4 max-w-lg"
        >
          {configSite.description2}
        </p>

        <div class="flex flex-wrap gap-4 mt-8">
          <a
            href={configSite.buttonLink}
            class="btn-primary inline-flex items-center gap-2 text-base no-underline px-8 py-3.5"
          >
            {configSite.button}
            <svg
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
          <a
            href={import.meta.env.BASE_URL.replace(/\/$/, "") + "/contacto"}
            class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl text-sm font-semibold no-underline text-slate-400 hover:text-white border border-slate-700 hover:border-slate-500 transition-all"
          >
            Contacto
          </a>
        </div>
      </div>

      <div class="relative">
        <div
          class="absolute -inset-4 bg-gradient-to-r from-cyan-500/10 to-blue-500/10 rounded-3xl blur-xl"
          aria-hidden="true"
        >
        </div>
        <div
          class="vibico-slider relative flex overflow-hidden rounded-2xl border border-slate-700/50 shadow-2xl shadow-black/40 bg-slate-900"
        >
          {
            Object.entries(configSite.images).map(([key, link]) => (
              <div class="relative w-full flex-shrink-0 overflow-hidden">
                <img
                  src={link.image}
                  alt={link.label}
                  class="w-full aspect-[4/3] object-cover"
                  loading="lazy"
                />
                <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-900/90 to-transparent px-5 pt-6">
                  <span class="text-sm text-white/80 font-medium drop-shadow-lg">
                    {link.label}
                  </span>
                </div>
              </div>
            ))
          }
        </div>
        <div class="flex gap-1.5 mt-4 justify-center">
          {
            Object.keys(configSite.images).map((_, i) => (
              <span
                class="h-1.5 rounded-full bg-slate-700 transition-all duration-300"
                style="width: 40px"
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const sliders = document.querySelectorAll(".vibico-slider");
  sliders.forEach((slider) => {
    let index = 0;
    const dots = slider.parentElement?.nextElementSibling?.children;
    const updateDots = (i) => {
      if (!dots) return;
      for (let d of dots) {
        d.classList.remove("bg-cyan-400");
        d.classList.add("bg-slate-700");
      }
      if (dots[i]) {
        dots[i].classList.remove("bg-slate-700");
        dots[i].classList.add("bg-cyan-400");
      }
    };
    updateDots(0);
    setInterval(() => {
      index = (index + 1) % slider.children.length;
      slider.scrollTo({ left: slider.clientWidth * index, behavior: "smooth" });
      updateDots(index);
    }, 4000);
  });
</script>
