---
import config from "../../config/index.js";

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith("/en") ? "en" : "es";
const configSite = config.languages[lang].site.home;
---

<section class="relative overflow-hidden py-8 md:py-12">
    <div class="container">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
            <div class="order-2 lg:order-1">
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight">
                    {configSite.title1}
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400 italic">
                        {configSite.title2}
                    </span>
                </h1>

                <p class="mt-6 text-lg text-slate-400 leading-relaxed">
                    {configSite.description1}
                </p>

                <p class="mt-4 text-base text-slate-500 italic border-l-4 border-cyan-500/50 pl-4">
                    {configSite.description2}
                </p>

                <div class="mt-10">
                    <a
                        href={configSite.buttonLink}
                        class="btn-primary inline-flex items-center gap-2 text-base no-underline"
                    >
                        {configSite.button}
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                        </svg>
                    </a>
                </div>
            </div>

            <div class="order-1 lg:order-2">
                <div class="vibico-slider flex overflow-hidden rounded-2xl border border-slate-700/50 shadow-2xl shadow-black/30">
                    {
                        Object.entries(configSite.images).map(([key, link]) => (
                            <div class="relative w-full flex-shrink-0">
                                <img
                                    src={link.image}
                                    alt={link.label}
                                    class="w-full aspect-[4/3] object-cover"
                                    loading="lazy"
                                />
                                <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-900/90 to-transparent px-4 py-4">
                                    <span class="text-xs text-slate-300 font-medium">{link.label}</span>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const sliders = document.querySelectorAll(".vibico-slider");

    sliders.forEach((slider) => {
        let index = 0;

        setInterval(() => {
            index = (index + 1) % slider.children.length;
            slider.scrollTo({
                left: slider.clientWidth * index,
                behavior: "smooth",
            });
        }, 4000);
    });
</script>
