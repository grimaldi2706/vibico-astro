---
interface Props {
  data: Record<string, { label: string; url: string; image: string }>;
}

const { data } = Astro.props;
---

<div class="flex flex-wrap justify-center gap-3">
  {
    Object.entries(data).map(([key, item]) => (
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class="card flex items-center justify-center gap-3 px-4 py-3 no-underline hover:border-cyan-600/50 min-w-[160px] flex-1 max-w-[220px]"
      >
        <img src={item.image} alt={item.label} class="w-8 h-8 object-contain flex-shrink-0" />
        <span class="text-sm font-medium text-slate-300 hover:text-white transition-colors">{item.label}</span>
      </a>
    ))
  }
</div>
