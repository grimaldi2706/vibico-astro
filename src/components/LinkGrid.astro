---
interface Props {
  data: Record<string, { label: string; url: string; image: string }>;
}

const { data } = Astro.props;
---

<div class="flex flex-wrap justify-center gap-4 m-4">
  {
    Object.entries(data).map(([key, item]) => (
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 p-2 w-[45%] max-w-[200px] rounded-lg border transition-all duration-200 hover:scale-[1.02]"
        style="
          background-color: var(--color-secondary, #023E8A);
          border-color: var(--color-secondary);
          color: #f7f2f2;
        "
      >
        <img src={item.image} alt={item.label} width="35" class="w-8 h-auto" />
        <span class="font-medium">{item.label}</span>
      </a>
    ))
  }
</div>
